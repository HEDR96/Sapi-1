{
  "name": "samadyafarm",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@samadya/web",
    "dev:admin": "npm run dev --workspace=@samadya/admin",
    "build": "npm run build --workspace=@samadya/web && npm run build --workspace=@samadya/admin",
    "build:web": "npm run build --workspace=@samadya/web",
    "build:admin": "npm run build --workspace=@samadya/admin",
    "lint": "turbo lint",
    "db:generate": "npm run generate --workspace=@samadya/prisma",
    "db:push": "npm run push --workspace=@samadya/prisma",
    "db:migrate": "npm run migrate --workspace=@samadya/prisma",
    "db:studio": "npm run studio --workspace=@samadya/prisma",
    "typecheck": "turbo typecheck"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  }
}
