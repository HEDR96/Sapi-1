{
  "name": "samadyafarm",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "pnpm --filter @samadya/web dev",
    "dev:admin": "pnpm --filter @samadya/admin dev",
    "dev:all": "turbo run dev --filter=@samadya/web --filter=@samadya/admin",
    "build": "turbo build",
    "build:web": "pnpm --filter @samadya/web build",
    "build:admin": "pnpm --filter @samadya/admin build",
    "lint": "turbo lint",
    "db:generate": "pnpm --filter @samadya/prisma prisma generate",
    "db:push": "pnpm --filter @samadya/prisma prisma db push",
    "db:migrate": "pnpm --filter @samadya/prisma prisma migrate dev",
    "db:studio": "pnpm --filter @samadya/prisma prisma studio",
    "typecheck": "turbo typecheck"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  }
}
