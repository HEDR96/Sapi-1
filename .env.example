# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/cattle_catalog"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="24h"

# Email (Resend)
RESEND_API_KEY="re_your_resend_api_key"

# iDrive E2 Storage
IDRIVE_ACCESS_KEY_ID="your_idrive_access_key"
IDRIVE_SECRET_ACCESS_KEY="your_idrive_secret_key"
IDRIVE_BUCKET="your-bucket-name"
IDRIVE_ENDPOINT="https://your-bucket.s3.region.idrivee2.com"
IDRIVE_REGION="ap-northeast-1"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
