# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/cattle_catalog"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="24h"

# Email (Resend)
RESEND_API_KEY="re_your_resend_api_key"

# Google Drive OAuth 2.0
# Create OAuth 2.0 Client ID at: https://console.cloud.google.com/apis/credentials
# 1. Go to APIs & Services > Credentials
# 2. Create Credentials > OAuth client ID
# 3. Application type: Web application
# 4. Add Authorized redirect URI: http://localhost:3000/api/auth/google/callback
# 5. Copy Client ID and Client Secret
GOOGLE_OAUTH_CLIENT_ID="YOUR_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="YOUR_CLIENT_SECRET"
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Google Drive Folder IDs
# Create folders in your personal Google Drive and share them with the OAuth app
# The folders should be accessible from your personal Drive (My Drive)
GOOGLE_DRIVE_IMAGE_FOLDER_ID="your-image-folder-id"
GOOGLE_DRIVE_VIDEO_FOLDER_ID="your-video-folder-id"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
