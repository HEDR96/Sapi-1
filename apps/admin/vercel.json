{
  "framework": "nextjs",
  "buildCommand": "npm run generate --workspace=@samadya/prisma && npm run build --workspace=@samadya/admin",
  "devCommand": "npm run dev --workspace=@samadya/admin",
  "functions": {
    "**/api/upload": {
      "maxDuration": 300
    },
    "**/api/upload-init": {
      "maxDuration": 60
    },
    "**/api/admin/media": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/api/upload",
      "headers": [
        { "key": "Body-Size-Limit", "value": "104857600" }
      ]
    },
    {
      "source": "/api/admin/media",
      "headers": [
        { "key": "Body-Size-Limit", "value": "104857600" }
      ]
    }
  ]
}
