# Docker Environment Variables
# Copy to .env and adjust values

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cattle_catalog

# Database URL (for services)
DATABASE_URL=postgresql://postgres:postgres@db:5432/cattle_catalog

# JWT Authentication
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_EXPIRES_IN=24h

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_CLIENT_SECRET
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Google Drive Folders
GOOGLE_DRIVE_IMAGE_FOLDER_ID=your-image-folder-id
GOOGLE_DRIVE_VIDEO_FOLDER_ID=your-video-folder-id

# App URLs
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
