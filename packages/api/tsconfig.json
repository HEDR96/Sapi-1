{
  "extends": "../../packages/shared/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@samadya/shared": [
        "../../packages/shared"
      ],
      "@samadya/shared/*": [
        "../../packages/shared/*"
      ],
      "@samadya/prisma": [
        "../../packages/prisma/generated"
      ],
      "@samadya/prisma/*": [
        "../../packages/prisma/generated/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
